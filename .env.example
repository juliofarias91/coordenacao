# ---------------------------------------------------------------------------
# SPBIM · Plataforma de Auditoria BIM — variáveis de ambiente
# Copie para .env e ajuste. O .env NÃO vai para o git.
# ---------------------------------------------------------------------------

# --- Aplicação -------------------------------------------------------------
APP_ENV=dev                       # dev | staging | prod
APP_DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Banco -----------------------------------------------------------------
POSTGRES_USER=spbim
POSTGRES_PASSWORD=spbim
POSTGRES_DB=spbim_auditoria
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Sobrescreve as variáveis acima se preenchida (útil em produção/managed DB)
DATABASE_URL=

# Usuário de aplicação usado pelas requisições (sujeito ao row-level security).
# O usuário das migrations é o POSTGRES_USER acima (dono das tabelas, BYPASSRLS).
APP_DB_USER=spbim_app
APP_DB_PASSWORD=spbim_app

# Ecoa todo SQL no log. Ligue só para depurar uma query específica.
DB_ECHO=false

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Desenvolvimento -------------------------------------------------------
# Endereço de uma API JÁ PUBLICADA. Só o `npm run dev:web` lê isto: com ele o
# dev sobe um processo só (o Vite), apontando a aplicação para essa API em vez
# de subir o backend local. Serve para quem vai mexer em TELA.
#
# Cuidado: é uma instância COMPARTILHADA. Se o schema dela estiver diferente do
# código em que você está mexendo, a tela quebra de um jeito confuso — nesse
# caso use `npm run dev`, que sobe a API local.
API_REMOTA=

# --- Segurança / JWT -------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-valor-em-producao
JWT_ALGORITHM=HS256
# Esta é a JANELA DE REVOGAÇÃO: nada no caminho da requisição consulta o banco,
# então desativar um usuário ou tirar uma permissão só passa a valer quando o
# access token expira. Aumentar este número aumenta o tempo em que um usuário
# desativado continua trabalhando.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# --- OIDC / SSO -------------------------------------------------------------
# Deixe OIDC_ENABLED=false para usar apenas login por senha (Argon2). Ligado, a
# tela de entrada desenha o botão do provedor — e SÓ ligado: quem descobre o
# nome dele é `GET /auth/config`, a partir do OIDC_ISSUER.
#
# ENTRAR COM O GOOGLE é este bloco preenchido, e mais nada de código. O cliente
# OIDC é genérico desde a Fase 0; o Google é um provedor OIDC como outro
# qualquer. Para ligá-lo:
#
#   1. Google Cloud Console › APIs & Services › Credentials › Create
#      credentials › OAuth client ID › Web application.
#   2. Em "Authorized redirect URIs", cole exatamente o OIDC_REDIRECT_URI
#      abaixo — o Google recusa o login se houver um caractere de diferença.
#   3. Copie Client ID e Client secret para as duas linhas abaixo.
#
# ⚠ O REDIRECT APONTA PARA A TELA, NÃO PARA A API. Quem chega ao redirect é o
# NAVEGADOR, redirecionado pelo provedor, e `GET /auth/oidc/callback` responde
# JSON — apontá-lo para a API mostrava uma página de JSON cru no fim do login.
# A rota `/entrar/sso` (em `App.tsx`) lê o `code` e faz a chamada ela mesma.
# Em produção é o domínio da aplicação: https://seu-dominio/entrar/sso
OIDC_ENABLED=false
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/entrar/sso
# `email` não é opcional: o e-mail É o login na plataforma. Um provedor que não
# o devolva autentica alguém que a plataforma não tem como encontrar depois.
OIDC_SCOPES=openid profile email

# --- E-mail (SMTP) ----------------------------------------------------------
# ⚠ TODO E-MAIL SAI DO SERVIDOR. Passo a passo em `docs/EMAIL.md`.
#
# NÃO é "o e-mail do Supabase": aquele é do Supabase AUTH, sobre `auth.users`, e
# esta plataforma tem identidade própria (`usuario` + Argon2 + JWT). Ele não
# teria como mandar um link com o NOSSO token. Mesmo adotando Supabase Auth
# seria preciso um SMTP — o remetente embutido deles é limitado e a própria
# documentação diz para não usá-lo em produção.
#
# Qualquer provedor com SMTP serve: Resend, Zoho, Brevo, Google Workspace.
#   587 = STARTTLS (o normal)      → SMTP_SSL=false
#   465 = SSL direto               → SMTP_SSL=true
#
# ⚠ SMTP_REMETENTE precisa ser de um domínio VERIFICADO na conta do provedor.
# Sem isso a mensagem é recusada por ele, ou entregue direto no spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMETENTE=
SMTP_REMETENTE_NOME=SPBIM Coordenação
SMTP_SSL=false

# O endereço público da aplicação — é com ele que o link do e-mail é montado.
# NÃO sai do cabeçalho `Host` de propósito: `Host` é controlado pelo cliente, e
# montar o link de redefinição a partir dele deixaria um atacante escolher para
# que domínio a vítima seria levada. Em produção: https://seu-dominio
APP_BASE_URL=http://localhost:5173

# --- Storage (S3 ou compatível: MinIO em dev) ------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=spbim-auditoria
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Autodesk Platform Services (Fases 2/3) --------------------------------
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_ACC_ACCOUNT_ID=
APS_WEBHOOK_SECRET=
