# ---------------------------------------------------------------------------
# SPBIM · variáveis do ambiente de produção (SP-501)
#
# Copie para `.env.prod` **no servidor** e preencha. Este arquivo não vai para
# o git. A API se recusa a subir com APP_ENV=prod se qualquer segredo aqui
# ficar no valor de exemplo — ver `verificar_producao` em app/core/config.py.
# ---------------------------------------------------------------------------

APP_ENV=prod
APP_DEBUG=false
API_PREFIX=/api/v1

# Origem única: o nginx do serviço `web` serve a aplicação e faz proxy do /api,
# então não há requisição entre origens. Use o domínio real, nunca `*`.
CORS_ORIGINS=https://auditoria.spbim.com.br

# --- Banco -----------------------------------------------------------------
POSTGRES_USER=spbim
POSTGRES_DB=spbim_auditoria
# openssl rand -base64 32
POSTGRES_PASSWORD=

# Papel de aplicação — é com ele que a API abre as conexões, sujeito ao RLS.
APP_DB_USER=spbim_app
APP_DB_PASSWORD=

DB_ECHO=false

# --- Banco gerenciado (Supabase) — ver docs/SUPABASE.md --------------------
# Preencha estas DUAS e as variáveis acima deixam de ser usadas. São URLs
# diferentes de propósito: a API vai pelo pooler em modo transação (6543) e as
# migrations pelo modo sessão (5432), porque DDL em pooler de transação quebra.
#
# APP_DATABASE_URL=postgresql+psycopg://spbim_app.<ref>:<senha>@aws-1-<regiao>.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<senha>@aws-1-<regiao>.pooler.supabase.com:5432/postgres
#
# Não aponte para db.<ref>.supabase.co: esse host só publica AAAA e não
# responde de rede sem IPv6 (o IPv4 dedicado é add-on pago). O modo sessão do
# pooler faz o mesmo papel e atende em IPv4.
#
# A aplicação detecta o pooler pela PORTA e desliga os prepared statements do
# psycopg — sem isso o erro "prepared statement não existe" aparece só sob
# carga. Force com `true` se o seu proxy não se anunciar na URL.
# DB_POOLER_TRANSACAO=

# --- Redis -----------------------------------------------------------------
# openssl rand -base64 32
REDIS_PASSWORD=

# --- Segurança -------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# --- SSO / OIDC -------------------------------------------------------------
# Para entrar com o Google: OIDC_ISSUER=https://accounts.google.com, e o par
# de credenciais do Google Cloud Console. O passo a passo está no `.env.example`.
#
# ⚠ O REDIRECT APONTA PARA A TELA (`/entrar/sso`), NÃO para a API: quem chega
# ao redirect é o navegador, e o callback responde JSON. Este endereço precisa
# estar cadastrado igual em "Authorized redirect URIs", no provedor.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://auditoria.spbim.com.br/entrar/sso

# --- Storage ---------------------------------------------------------------
S3_BUCKET=spbim-auditoria
S3_REGION=us-east-1
# openssl rand -base64 24 — em produção gerenciada, troque por chave de IAM.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Com o Storage do Supabase (bucket privado; a leitura sempre sai assinada):
# S3_ENDPOINT_URL=https://<ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=<a região do projeto>
S3_ENDPOINT_URL=

# --- E-mail (SMTP) ----------------------------------------------------------
# Sem estas variáveis nada quebra, e é deliberado: o convite continua sendo
# criado (o link fica na tela de quem convidou) e o pedido de "esqueci minha
# senha" vira notificação para os admins. O que se perde é a ENTREGA — todo link
# passa a ser copiado e mandado à mão. Ver `docs/EMAIL.md`.
#
# A conta da SPBIM é a de serviço `no-reply@spbim.com.br` em
# smtp1.xmailer.com.br. A senha NÃO vem para cá: ela mora só neste arquivo, no
# servidor (ou no painel do provedor de hospedagem).
#
# ⚠ 465 exige SMTP_SSL=true. Com false o handshake falha falando em "wrong
# version number", sem mencionar porta nenhuma.
# ⚠ Se a senha tiver `#`, ponha entre aspas — senão o resto da linha vira
# comentário e ela chega truncada.
SMTP_HOST=smtp1.xmailer.com.br
SMTP_PORT=465
SMTP_USER=no-reply@spbim.com.br
SMTP_PASSWORD=
SMTP_REMETENTE=no-reply@spbim.com.br
SMTP_REMETENTE_NOME=SPBIM Coordenação
SMTP_SSL=true

# ⚠ O ENDEREÇO PÚBLICO DA APLICAÇÃO, e ele monta o link de TODO e-mail. Deixado
# no padrão de desenvolvimento (localhost), cada convite mandaria a pessoa para o
# computador dela mesma. A API RECUSA SUBIR com APP_ENV=prod se este valor
# apontar para localhost — ver `problemas_de_producao`, em app/core/config.py.
#
# Não sai do cabeçalho `Host` de propósito: ele é controlado por quem faz a
# requisição, e montar o link de redefinição a partir dele deixaria um atacante
# escolher para que domínio a vítima seria levada.
APP_BASE_URL=https://auditoria.spbim.com.br

# --- Autodesk Platform Services (decisão aberta nº 3) ----------------------
# Sem estes três, a ingestão pelo ACC fica desligada e o webhook recusa tudo.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_ACC_ACCOUNT_ID=
APS_WEBHOOK_SECRET=

# --- Operação --------------------------------------------------------------
PORTA_HTTP=8080
IMAGEM_API=spbim/api:latest
IMAGEM_WEB=spbim/web:latest

# Horas em UTC. O backup do bucket roda depois do banco, para o espelho nunca
# ficar mais antigo que o dump que o referencia.
BACKUP_HORA=03
BACKUP_HORA_S3=04
BACKUP_RETENCAO_DIAS=30
