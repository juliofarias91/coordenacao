# ---------------------------------------------------------------------------
# SPBIM · Plataforma de Auditoria BIM — variáveis de ambiente
# Copie para .env e ajuste. O .env NÃO vai para o git.
# ---------------------------------------------------------------------------

# --- Aplicação -------------------------------------------------------------
APP_ENV=dev                       # dev | staging | prod
APP_DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Banco -----------------------------------------------------------------
POSTGRES_USER=spbim
POSTGRES_PASSWORD=spbim
POSTGRES_DB=spbim_auditoria
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Sobrescreve as variáveis acima se preenchida (útil em produção/managed DB)
DATABASE_URL=

# Usuário de aplicação usado pelas requisições (sujeito ao row-level security).
# O usuário das migrations é o POSTGRES_USER acima (dono das tabelas, BYPASSRLS).
APP_DB_USER=spbim_app
APP_DB_PASSWORD=spbim_app

# Ecoa todo SQL no log. Ligue só para depurar uma query específica.
DB_ECHO=false

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Segurança / JWT -------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-valor-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# --- OIDC / SSO (Fase 0 — decisão em aberto nº 2 do plano técnico) ----------
# Deixe OIDC_ENABLED=false para usar apenas login por senha (Argon2).
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
OIDC_SCOPES=openid profile email

# --- Storage (S3 ou compatível: MinIO em dev) ------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=spbim-auditoria
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Autodesk Platform Services (Fases 2/3) --------------------------------
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_ACC_ACCOUNT_ID=
APS_WEBHOOK_SECRET=
