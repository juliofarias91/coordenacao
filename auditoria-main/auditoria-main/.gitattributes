# Normaliza a quebra de linha: LF no repositório, nativo no working copy.
* text=auto

*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.ps1  text eol=crlf

*.ifc  binary
*.rvt  binary
*.png  binary
*.jpg  binary
*.pdf  binary
*.docx binary
